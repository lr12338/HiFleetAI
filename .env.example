# Application runtime
APP_ENV=development
APP_NAME=HiFleetAI
APP_HOST=0.0.0.0
APP_PORT=8000

# Security placeholders for local development.
# Replace SECRET_KEY outside source control before production runtime validation.
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL connection values.
# DATABASE_URL may be provided directly or derived from the component values below.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hifleet_ai
POSTGRES_USER=hifleet
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://hifleet:change-me@localhost:5432/hifleet_ai

# Redis connection.
REDIS_URL=redis://localhost:6379/0

# Object storage placeholders.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=hifleet-ai
MINIO_SECURE=false

# Model gateway placeholders.
# ARK_API_KEY must be provided locally when real Ark calls are enabled.
MODEL_PROVIDER=ark
ARK_API_KEY=replace-with-your-local-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/responses
ARK_TEXT_MODEL=deepseek-v4-flash-260425
ARK_VISION_MODEL=doubao-seed-2-0-lite-260215

# Harness integration defaults.
HARNESS_AGENT_BASE_URL=http://localhost:8000
HARNESS_REPORT_DIR=harness/reports
